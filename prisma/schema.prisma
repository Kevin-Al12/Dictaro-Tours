// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  price       Float
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quoteItems   QuoteItem[]
  invoiceItems InvoiceItem[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // "owner" | "admin" (acceso total) | "vendedor" (restringido)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdInvoices  Invoice[] @relation("InvoiceCreatedBy")
  paymentsReceived Payment[] @relation("PaymentReceivedBy")
}

model Client {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  email        String?  @unique
  document     String?
  notes        String?
  passwordHash String?  // solo se define cuando el cliente se registra; null = registro "invitado" creado desde una reserva o por un admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotes    Quote[]
  bookings  Booking[]
  invoices  Invoice[]
}

model Quote {
  id        String      @id @default(cuid())
  number    Int         @unique
  status    String      @default("borrador")
  total     Float       @default(0)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  client    Client      @relation(fields: [clientId], references: [id])
  clientId  String
  items     QuoteItem[]
  invoice   Invoice?
  booking   Booking?    @relation(fields: [bookingId], references: [id])
  bookingId String?     @unique
}

model Invoice {
  id          String    @id @default(cuid())
  number      Int?      @unique       // se asigna solo al emitir (ver ruta /emit); null mientras está en borrador
  ncfType     String?                 // placeholder hasta definir proveedor de e-CF con la dueña
  ncfNumber   String?                 // placeholder: NCF o trackId real cuando se integre un proveedor
  status      String    @default("borrador") // borrador | emitida | pagada_parcial | pagada | anulada
  issueDate   DateTime  @default(now())
  dueDate     DateTime?
  currency    String    @default("DOP")
  subtotal    Float     @default(0)
  itbis       Float     @default(0)
  total       Float     @default(0)
  amountPaid  Float     @default(0)
  notes       String?
  voidReason  String?
  voidedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client      Client        @relation(fields: [clientId], references: [id])
  clientId    String
  quote       Quote?        @relation(fields: [quoteId], references: [id])
  quoteId     String?       @unique
  items       InvoiceItem[]
  payments    Payment[]
  createdBy   AdminUser?    @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdById String?
}

model InvoiceItem {
  id          String   @id @default(cuid())
  description String
  unitPrice   Float
  quantity    Int      @default(1)
  itbisRate   Float    @default(0)
  subtotal    Float

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
}

model Payment {
  id           String    @id @default(cuid())
  amount       Float
  method       String                 // efectivo | transferencia | tarjeta | cheque
  reference    String?
  receivedAt   DateTime  @default(now())
  notes        String?
  createdAt    DateTime  @default(now())

  invoice      Invoice    @relation(fields: [invoiceId], references: [id])
  invoiceId    String
  receivedBy   AdminUser? @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  receivedById String?
}

model CompanySettings {
  id          String   @id @default("default")
  legalName   String   @default("D'Itaros Tours")
  rnc         String?
  address     String?
  itbisRate   Float    @default(0.18)
  ncfProvider String?                 // null mientras no se defina con la dueña
  logoUrl     String?
  updatedAt   DateTime @updatedAt
}

model Destination {
  id                String   @id
  slug              String   @unique
  name              String
  country           String
  continent         String
  shortDescription  String
  description       String
  image             String
  gallery           Json
  price             Float
  originalPrice     Float?
  duration          String
  departureDates    Json
  includes          Json
  excludes          Json
  highlights        Json
  rating            Float    @default(0)
  reviews           Int      @default(0)
  available         Int      @default(0)
  featured          Boolean  @default(false)
  tag               String?
  lat               Float
  lng               Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Hotel {
  id             String   @id
  slug           String   @unique
  name           String
  location       String
  department     String
  description    String
  image          String
  gallery        Json
  pricePerPerson Float
  stars          Int
  services       Json
  rating         Float    @default(0)
  reviews        Int      @default(0)
  available      Boolean  @default(true)
  category       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Excursion {
  id             String   @id
  name           String
  location       String
  description    String
  image          String
  price          Float
  duration       String
  dates          Json
  availableSpots Int
  totalSpots     Int
  includes       Json
  difficulty     String
  category       String
  rating         Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  type          String   // "booking" | "quote"
  itemType      String   // "destino" | "hotel" | "excursion"
  itemLabel     String
  date          String?
  passengers    Int      @default(1)
  total         Float    @default(0)
  status        String   @default("pendiente") // "pendiente" | "confirmada" | "cancelada" | "completada"
  notes         String?
  customerName  String
  customerEmail String
  customerPhone String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        Client?  @relation(fields: [clientId], references: [id])
  clientId      String?
  quote         Quote?
}

model QuoteItem {
  id          String  @id @default(cuid())
  description String
  unitPrice   Float
  quantity    Int     @default(1)
  subtotal    Float

  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
}
